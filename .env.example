# ============================================================
# lr-bestsellers — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Google / Gemini API
# ----------------------------------------------------------
# Used for Gemini 2.0 Flash (LLM) and gemini-embedding-2 (embeddings).
# Obtain from https://aistudio.google.com/app/apikey
# Also accepted: GEMINI_API_KEY
GOOGLE_API_KEY=your-google-api-key-here

# Optional model overrides. Leave unset to use the defaults.
# Also accepted: GEMINI_MODEL
# LLM_MODEL=gemini-2.0-flash
# EMBEDDING_MODEL=gemini-embedding-2

# ----------------------------------------------------------
# BigQuery
# ----------------------------------------------------------
# Billing project — the GCP project whose quota/costs cover these queries.
# Data tables live in liveramp-eng-pie (fully qualified in best_sellers.sql).
# Also accepted: BQ_PROJECT
BIGQUERY_PROJECT=liveramp-eng-qa-reliability

# Path to GCP service account JSON (local dev). Leave unset on GKE/Cloud Run (ADC).
# GOOGLE_APPLICATION_CREDENTIALS=/Users/yourname/.gcp/lr-bestsellers-sa.json

# ----------------------------------------------------------
# CSV catalog (offline BigQuery dump)
# ----------------------------------------------------------
# Dump paged by GET /v1/segments when no query is supplied.
# Also accepted: CSV_DUMP_PATH
# Default: csv_dump/segment_recommendation_features.csv
CSV_CATALOG_PATH=csv_dump/segment_recommendation_features.csv

# ----------------------------------------------------------
# Qdrant Vector Store
# ----------------------------------------------------------
# URL for the Qdrant instance. Use http://localhost:6333 for local Docker.
# Default: http://localhost:6333
QDRANT_URL=http://localhost:6333

# API key for Qdrant Cloud. Leave blank when using a local instance.
# QDRANT_API_KEY=your-qdrant-cloud-api-key

# ----------------------------------------------------------
# LangSmith Tracing (optional)
# ----------------------------------------------------------
# Enable to trace LangGraph runs in LangSmith.
# LANGSMITH_TRACING_V2=true
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=lr-bestsellers

# ----------------------------------------------------------
# Retrieval Tuning
# ----------------------------------------------------------
# Minimum cosine similarity score for a retrieved chunk to be included.
# Range: 0.0–1.0. Recommended: 0.65.
# SIMILARITY_THRESHOLD=0.65

# Maximum number of candidate chunks to retrieve before re-ranking.
# Range: 1–100. Recommended: 10.
# MAX_RETRIEVAL_RESULTS=10

# ----------------------------------------------------------
# System
# ----------------------------------------------------------
# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Default: INFO
# LOG_LEVEL=INFO

# Deployment environment: development | staging | production
# Default: development
# ENVIRONMENT=development
